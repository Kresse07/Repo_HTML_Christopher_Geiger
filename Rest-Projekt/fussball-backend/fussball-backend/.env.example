# =========================================================================
#  VORLAGE für die .env-Datei
#  Diese Datei DARF in Git committet werden (enthält keine echten Secrets).
#  Kopiere sie zu ".env" und passe die Werte an:
#      cp .env.example .env
# =========================================================================

# --- App-Konfiguration -----------------------------------------------
NODE_ENV=development
APP_PORT=3000

# --- Datenbank-Zugangsdaten ------------------------------------------
DB_ROOT_PASSWORD=dein_root_passwort_hier
DB_NAME=fussball_db
DB_USER=fussball_user
DB_PASSWORD=dein_db_passwort_hier
DB_EXTERNAL_PORT=3307

# --- JWT-Konfiguration (H7) ------------------------------------------
# Sicheren Wert generieren mit:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dein_langes_zufaelliges_secret_hier
JWT_EXPIRES_IN=24h

# --- Bild-Upload-Konfiguration ---------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
